{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit-rust.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "_comment": "Auto-allowlist commands the AI runs frequently for this repo. Add personal/private grants to .claude/settings.local.json (gitignored) instead of here.",
    "allow": [
      "Bash(actionlint .github/workflows/*.yml)",
      "Bash(gh run *)",
      "Bash(.venv/bin/python -m scripts.bench_compare *)",
      "Bash(.venv/bin/python -m scripts.test_extract.from_c *)",
      "Bash(.venv/bin/python -m scripts.test_extract.from_py *)",
      "Bash(.venv/bin/python -m scripts.test_extract.from_r *)",
      "Bash(.venv/bin/python scripts/oracle.py)"
    ]
  }
}
