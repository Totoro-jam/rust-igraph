{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo run *)",
      "Bash(cargo bench *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo doc *)",
      "Bash(cargo deny *)",
      "Bash(cargo package *)",
      "Bash(cargo publish --dry-run *)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git grep *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git stash list)",
      "Bash(git add *)",
      "Bash(git commit *)",

      "Bash(actionlint *)",
      "Bash(mdbook *)",

      "Bash(.venv/bin/python -m scripts.oracle)",
      "Bash(.venv/bin/python scripts/oracle.py)",
      "Bash(.venv/bin/python -m scripts.bench_compare *)",
      "Bash(.venv/bin/python -m scripts.test_extract.from_c *)",
      "Bash(.venv/bin/python -m scripts.test_extract.from_py *)",
      "Bash(.venv/bin/python -m scripts.test_extract.from_r *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(echo *)",

      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:rust-lang.github.io)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:igraph.org)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit-rust.sh"
          }
        ]
      }
    ]
  }
}
