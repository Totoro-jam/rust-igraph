# Rust build artifacts
target/
**/*.rs.bk
*.pdb

# Library: do not track Cargo.lock (applications should)
Cargo.lock

# Reference source clones (see references/README.md)
references/*
!references/README.md

# Claude Code config
# settings.json is generated per-clone from settings.json.sample (committed).
# settings.local.json holds personal grants. Both are gitignored to stop the
# IDE-auto-edit churn — see CONTRIBUTING.md "Claude Code settings".
.claude/settings.json
.claude/settings.local.json

# Direnv / shell
.envrc
.direnv/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / coverage artifacts
*.profraw
tarpaulin-report.html
lcov.info
target-cov/

# Python (oracle.py environment)
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Doc build output
book/book/                  # mdbook output dir (book/src/ source is tracked)
docs/_build/

# Hook log (not committed)
.codefuse/tracking/agent_actions.log

# Misc temporary
*.tmp
*.bak
