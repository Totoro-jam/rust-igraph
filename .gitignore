# Rust build artifacts
target/
**/*.rs.bk
*.pdb

# Library: do not track Cargo.lock (applications should)
Cargo.lock

# Reference source clones (see references/README.md)
references/*
!references/README.md

# Claude Code: only the per-machine local file is gitignored.
# .claude/settings.json IS committed (Anthropic's intended pattern); the
# pre-commit hook in .githooks/ blocks accidental noise from auto-allow
# grants. See CONTRIBUTING.md "Claude Code settings" for the discipline.
.claude/settings.local.json

# Direnv / shell
.envrc
.direnv/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / coverage artifacts
*.profraw
tarpaulin-report.html
lcov.info
target-cov/

# Python (oracle.py environment)
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Doc build output
# mdbook output dirs (source is tracked, built output is not)
book/book/
book-zh/book/
docs/_build/

# Website build artifacts
website/node_modules/
website/dist/
website/playground/node_modules/
website/playground/dist/

# Hook log (not committed)
.codefuse/tracking/agent_actions.log

# Misc temporary
*.tmp
*.bak
