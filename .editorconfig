# EditorConfig — https://editorconfig.org/
# Cross-IDE consistency for everything cargo fmt does not touch.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown is intentionally permissive about trailing whitespace
# (two-space line breaks). Disable trim there.
trim_trailing_whitespace = false

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.{py}]
indent_size = 4

[*.{R,r}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab
